@startuml

class com.springboot.MyTodoList.config.BotProps {
	{field} +name : String
	{field} +token : String
}


class com.springboot.MyTodoList.config.CorsConfig {
	{field} ~logger : org.slf4j.Logger
	{method} +corsFilter () : org.springframework.web.filter.CorsFilter
}


class com.springboot.MyTodoList.config.DataInitializer {
	{field} -employeeRepository : com.springboot.MyTodoList.repository.EmployeeRepository
	{field} {static} -logger : org.slf4j.Logger
	{field} -passwordEncoder : org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder
	{method} +seedAdminUser () : void
}


class com.springboot.MyTodoList.config.DbSettings {
	{field} +driver_class_name : String
	{field} +password : String
	{field} +url : String
	{field} +username : String
}


class com.springboot.MyTodoList.config.OpenRouterConfig {
	{field} -apiKey : String
	{method} +httpClient () : org.apache.hc.client5.http.impl.classic.CloseableHttpClient
	{method} +openRouterRequest ( apiUrl : String ) : org.apache.hc.client5.http.classic.methods.HttpPost
}


class com.springboot.MyTodoList.config.OracleConfiguration {
	{field} -dbPassword : String
	{field} -dbUrl : String
	{field} -dbUser : String
	{field} -driverClassName : String
	{field} ~logger : org.slf4j.Logger
	{method} +dataSource () : javax.sql.DataSource
}






@enduml