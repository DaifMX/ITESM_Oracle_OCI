{
    "branches": ["main"],
    "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        ["@semantic-release/changelog", {
            "changelogFile": "CHANGELOG.md"
        }],
        ["@semantic-release/exec", {
            "prepareCmd": "mvn -f MtdrSpring/backend/pom.xml versions:set -DnewVersion=${nextRelease.version} -DgenerateBackupPoms=false && npm --prefix MtdrSpring/backend/src/main/frontend version ${nextRelease.version} --no-git-tag-version"
        }],
        ["@semantic-release/git", {
            "assets": [
                "CHANGELOG.md",
                "MtdrSpring/backend/pom.xml",
                "MtdrSpring/backend/src/main/frontend/package.json"
            ],
            "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }],
        "@semantic-release/github"
    ]
}
